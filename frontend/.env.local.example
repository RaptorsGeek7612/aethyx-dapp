# Get a free project ID at https://cloud.walletconnect.com — required for WalletConnect-based
# mobile wallets; injected wallets like MetaMask work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Filled in after `hardhat ignition deploy ignition/modules/InvestOrGateway.ts` from backend/.
NEXT_PUBLIC_GATEWAY_ADDRESS=
NEXT_PUBLIC_VAULT_MANAGER_ADDRESS=
NEXT_PUBLIC_ORACLE_MANAGER_ADDRESS=
# Comma-separated: priceSourcePrimary,priceSourceSecondary from the same deployment.
NEXT_PUBLIC_PRICE_SOURCE_ADDRESSES=

# Optional override for contract reads — falls back to publicnode (see wagmi.ts), which keeps its
# CORS header under this app's real load and answers one batched POST of 75 reads in 163 ms. If
# you override it, load-test the candidate (not just one isolated request) before trusting it:
# several providers advertise generous limits that don't hold up under this app's real traffic.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Optional override for eth_getLogs only — falls back to Tenderly's public Sepolia gateway (see
# lib/logs-client.ts). Deliberately separate from the variable above, because the endpoint that
# handles this app's read burst and the endpoint that can still see its history are not the same
# one: publicnode prunes to about the last 50,000 blocks and answers an older log query with an
# empty array rather than an error, which reads as "no activity" in the UI.
#
# Leaving this empty is the measured best option, not a stopgap. Both keyed free tiers were tried
# against this app's real history and real regime and both are worse than the unkeyed default:
# Alchemy's free plan caps eth_getLogs at a 10-block range, and Infura's 10,000-block cap splits
# every query into 11 requests, at which point its rate limiter refuses one in five. See the
# table in lib/logs-client.ts. If you do override this, test a candidate over the app's *full*
# block range AND at its sustained request rate — a recent-range curl is the check that missed
# this once already, and a single full-range curl is the check that would have missed Infura.
NEXT_PUBLIC_SEPOLIA_LOGS_RPC_URL=

# The block number the contracts above were deployed at. Without it, every getLogs scan (price
# history, transaction history) falls back to a ~200k-block lookback window instead of scanning
# from genesis — setting this exactly avoids that window ever missing older activity.
NEXT_PUBLIC_DEPLOYMENT_BLOCK=
