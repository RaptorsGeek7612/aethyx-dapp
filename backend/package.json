{
  "name": "Invest'Or Dapp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:ts": "eslint .",
    "lint": "npm run lint:sol && npm run lint:ts",
    "format": "prettier --write \"contracts/**/*.sol\" \"test/**/*.ts\" \"ignition/**/*.ts\" \"scripts/**/*.ts\" \"hardhat.config.ts\"",
    "format:check": "prettier --check \"contracts/**/*.sol\" \"test/**/*.ts\" \"ignition/**/*.ts\" \"scripts/**/*.ts\" \"hardhat.config.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "chai": "^6.2.2",
    "eslint": "^10.9.1",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.11.1",
    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.1",
    "solhint": "^6.2.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@chainlink/contracts": "^1.5.0"
  }
}
